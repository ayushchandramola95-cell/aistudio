# ==============================================================================
# AI Studio Configuration (.env.example)
# Copy to .env for local development. NEVER commit real secrets to Git.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string
API_BASE_URL=http://localhost:8100
WEB_BASE_URL=http://localhost:3100
WEB_PORT=3100
API_PORT=8100

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aistudio

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379/0

# Object Storage (GCS or Cloudflare R2)
STORAGE_PROVIDER=gcs
GCS_BUCKET_NAME=aistudio-media-dev
GCS_PROJECT_ID=your-gcp-project-id
# R2_ACCOUNT_ID=your-r2-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key
# R2_SECRET_ACCESS_KEY=your-r2-secret-key
# R2_BUCKET_NAME=aistudio-media-dev

# Google Cloud AI / Vertex AI Credentials
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-service-account.json
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# GPU Inference Worker (On-Demand Worker Node)
GPU_WORKER_ENABLED=false
GPU_WORKER_ENDPOINT=http://127.0.0.1:8188
GPU_WORKER_AUTH_TOKEN=replace-with-internal-worker-secret

# JWT Authentication
JWT_SECRET=replace-with-a-secure-jwt-signing-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Stripe Payments (Phase 10)
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace

